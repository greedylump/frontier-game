{
  "name": "graduated-policies",
  "description": "Two prescribed graduated rules respond to capability deficits and the shared safety gap. Parameters are illustrative, not optimized.",
  "category": "research",
  "model": {
    "horizon": 30,
    "capability_rate": 1.0,
    "safety_rate": 0.6,
    "noise": 0.25,
    "hazard_scale": 0.01,
    "first_mover_value": 10.0,
    "catastrophe_cost": 50.0
  },
  "trials": 1000,
  "seed": 2026,
  "policies": {
    "a": {
      "type": "graduated",
      "parameters": {
        "base_allocation": 0.6,
        "deficit_response": 0.1,
        "safety_response": 0.2
      }
    },
    "b": {
      "type": "graduated",
      "parameters": {
        "base_allocation": 0.6,
        "deficit_response": 0.1,
        "safety_response": 0.2
      }
    }
  }
}
