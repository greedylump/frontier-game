{
  "name": "asymmetric-safety-gap",
  "description": "A uses normal capability allocation 0.60 and B uses 0.50; both switch to 0.30 when the shared gap exceeds zero.",
  "category": "research",
  "model": {
    "horizon": 30,
    "capability_rate": 1.0,
    "safety_rate": 0.6,
    "noise": 0.25,
    "hazard_scale": 0.01,
    "first_mover_value": 10.0,
    "catastrophe_cost": 50.0
  },
  "trials": 1000,
  "seed": 2026,
  "policies": {
    "a": {
      "type": "safety_gap",
      "parameters": {
        "normal_allocation": 0.60,
        "cautious_allocation": 0.30,
        "gap_threshold": 0.0
      }
    },
    "b": {
      "type": "safety_gap",
      "parameters": {
        "normal_allocation": 0.50,
        "cautious_allocation": 0.30,
        "gap_threshold": 0.0
      }
    }
  }
}
